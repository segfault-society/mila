# Neon Postgres (pooled for the app, unpooled for migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Vercel AI Gateway key, used only by the parser's LLM fallback and message wording
AI_GATEWAY_API_KEY=
# SMS gateway: leave empty for dry-run (messages are logged to the messages table, not sent)
SMS_PROVIDER=dry_run
SMS_API_KEY=
SMS_SENDER_ID=
